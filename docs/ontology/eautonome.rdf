>
  <eau:PipeConfiguration rdf:about="https://w3id.org/eautonome/pipeConfigurationStraight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="https://w3id.org/eautonome/">
        <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
        <rdfs:label xml:lang="en">The Eautonome Ontology</rdfs:label>
        <rdfs:label xml:lang="fr">L'ontologie Eautonome</rdfs:label>
        <dcterms:title xml:lang="en">The Eautonome Ontology</dcterms:title>
        <dcterms:title xml:lang="fr">L'ontologie Eautonome</dcterms:title>
        <dcterms:description xml:lang="en">The Eautonome Ontology provides an OWL representation of residential water end-use monitoring. It models domestic water uses, quality levels, and greywater reuse processes, specifically describing the monitoring and observations of the system to reduce water consumption.</dcterms:description>
        <dcterms:description xml:lang="fr">L'ontologie Eautonome fournit une représentation OWL du suivi des usages résidentiels de l'eau. Elle modélise les usages domestiques de l'eau, les niveaux de qualité et les processus de réutilisation des eaux grises, en décrivant spécifiquement le suivi et les observations du système pour réduire la consommation d'eau.</dcterms:description>
        <dcterms:creator rdf:resource="https://w3id.org/people/erdemonal/me"/>
        <dcterms:publisher rdf:resource="https://www.leesu.fr/"/>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:created>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-04</dcterms:issued>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-01</dcterms:modified>
        <dcterms:source rdf:resource="https://www.leesu.fr/eautonome"/>
        <dcterms:identifier rdf:resource="https://doi.org/10.5281/zenodo.22229871"/>
        <dcterms:isVersionOf rdf:resource="https://doi.org/10.5281/zenodo.21894601"/>
        <bibo:doi>10.5281/zenodo.22229871</bibo:doi>
        <schema1:logo rdf:resource="https://erdemonal.github.io/eautonome/logo.svg"/>
        <schema1:includedInDataCatalog rdf:resource="https://lov.linkeddata.es/dataset/lov"/>
        <mod:status>release</mod:status>
        <dcterms:bibliographicCitation xml:lang="en">Önal, E. The Eautonome Ontology (Version v1.0.1). https://doi.org/10.5281/zenodo.22229871</dcterms:bibliographicCitation>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <owl:versionIRI rdf:resource="https://w3id.org/eautonome/1.0.1"/>
        <vann:preferredNamespacePrefix>eau</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/eautonome/</vann:preferredNamespaceUri>
        <rdfs:seeAlso rdf:resource="https://www.leesu.fr/eautonome"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
        <owl:imports rdf:resource="https://saref.etsi.org/saref4watr/v2.1.1/"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Straight pipe configuration</rdfs:label>
    <rdfs:label xml:lang="fr">Configuration tuyau droit</rdfs:label>
    <rdfs:comment xml:lang="en">A pipe configuration with a straight section and no bends.</rdfs:comment>
  </eau:PipeConfiguration>
  <owl:DatatypeProperty rdf:about="https://w3id.org/eautonome/hasDurationSeconds">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">has duration in seconds</rdfs:label>
    <rdfs:comment xml:lang="en">Duration of the observation in seconds.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
  </owl:DatatypeProperty>
  <sosa:ObservationCollection rdf:about="https://w3id.org/eautonome/obsColAfternoonShower20260628">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
    <rdfs:label xml:lang="en">Afternoon shower consumption</rdfs:label>
    <rdfs:label xml:lang="fr">Consommation douche de l'après-midi</rdfs:label>
    <rdfs:comment xml:lang="en">Flow observations during the afternoon shower period.</rdfs:comment>
    <sosa:madeBySensor>
      <eau:ShowerSensor rdf:about="https://w3id.org/eautonome/hansaActivejetDigital">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">HANSA Activejet Digital</rdfs:label>
        <rdfs:comment xml:lang="en">A HANSA Activejet Digital Bluetooth hand shower.</rdfs:comment>
        <eau:hasOperationalStatus>active</eau:hasOperationalStatus>
        <eau:monitors rdf:resource="https://w3id.org/eautonome/mpBathroomHot"/>
        <sosa:observes rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:observes rdf:resource="https://saref.etsi.org/saref4watr/FlowVolume"/>
        <sosa:observes rdf:resource="https://saref.etsi.org/saref4watr/FlowTemperature"/>
        <sosa:hasSystemCapability rdf:resource="https://w3id.org/eautonome/capHansaActivejetDigital"/>
        <sosa:hasOperatingConditions rdf:resource="https://w3id.org/eautonome/condHansaActivejetDigital"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowVolume"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowTemperature"/>
        <sosa:implements rdf:resource="https://w3id.org/eautonome/showerObservingProcedure"/>
      </eau:ShowerSensor>
    </sosa:madeBySensor>
    <sosa:observedProperty>
      <rdf:Description rdf:about="https://saref.etsi.org/saref4watr/FlowRate">
        <sosa:isObservedBy rdf:resource="https://w3id.org/eautonome/flowmeterHeaterOutput"/>
        <sosa:isObservedBy rdf:resource="https://w3id.org/eautonome/flowmeterBathroomHot"/>
        <sosa:isObservedBy rdf:resource="https://w3id.org/eautonome/flowmeterBathroomCold"/>
        <sosa:isObservedBy rdf:resource="https://w3id.org/eautonome/flowmeterWashingMachine"/>
        <sosa:isObservedBy rdf:resource="https://w3id.org/eautonome/flowmeterBasementCold"/>
        <sosa:isObservedBy rdf:resource="https://w3id.org/eautonome/flowmeterToiletCold"/>
        <sosa:isObservedBy rdf:resource="https://w3id.org/eautonome/hansaActivejetDigital"/>
      </rdf:Description>
    </sosa:observedProperty>
    <sosa:usedProcedure>
      <eau:ShowerObservingProcedure rdf:about="https://w3id.org/eautonome/showerObservingProcedure">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">Shower observing procedure</rdfs:label>
        <rdfs:label xml:lang="fr">Procédure d'observation douche</rdfs:label>
        <rdfs:comment xml:lang="en">Shower data acquisition via Bluetooth.</rdfs:comment>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/hansaActivejetDigital"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowVolume"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowTemperature"/>
      </eau:ShowerObservingProcedure>
    </sosa:usedProcedure>
    <sosa:hasFeatureOfInterest>
      <eau:MeasurementPoint rdf:about="https://w3id.org/eautonome/mpBathroomHot">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">Bathroom hot water measurement point</rdfs:label>
        <rdfs:label xml:lang="fr">Point de mesure d'eau chaude de la salle de bain</rdfs:label>
        <rdfs:comment xml:lang="en">Measurement point on the bathroom hot water circuit.</rdfs:comment>
        <eau:measuresWaterKind rdf:resource="https://saref.etsi.org/saref4watr/DrinkingWater"/>
        <eau:locatedIn rdf:resource="https://w3id.org/eautonome/roomBathroom"/>
        <eau:measuresOnAsset rdf:resource="https://w3id.org/eautonome/pipeBathroomHot"/>
        <eau:servesEndpoint rdf:resource="https://w3id.org/eautonome/roomBathroom"/>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
      </eau:MeasurementPoint>
    </sosa:hasFeatureOfInterest>
    <sosa:hasUltimateFeatureOfInterest>
      <s4watr:Water rdf:about="https://w3id.org/eautonome/domesticGreywater">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">Domestic greywater</rdfs:label>
        <rdfs:label xml:lang="fr">Eaux grises domestiques</rdfs:label>
        <rdfs:comment xml:lang="en">Greywater within the system, used as the feature of interest for observations.</rdfs:comment>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowVolume"/>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowTemperature"/>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/Conductivity"/>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/Temperature"/>
      </s4watr:Water>
    </sosa:hasUltimateFeatureOfInterest>
    <sosa:phenomenonTime>
      <time:Interval rdf:nodeID="neafc0a186dcc47bc9e960b290a8eb5ceb34">
        <time:hasBeginning>
          <time:Instant rdf:nodeID="neafc0a186dcc47bc9e960b290a8eb5ceb35">
            <time:inXSDDateTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-28T15:49:48+02:00</time:inXSDDateTime>
          </time:Instant>
        </time:hasBeginning>
        <time:hasEnd>
          <time:Instant rdf:nodeID="neafc0a186dcc47bc9e960b290a8eb5ceb36">
            <time:inXSDDateTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-28T16:03:38+02:00</time:inXSDDateTime>
          </time:Instant>
        </time:hasEnd>
      </time:Interval>
    </sosa:phenomenonTime>
    <eau:hasConsumptionEvent>
      <eau:ConsumptionEvent rdf:about="https://w3id.org/eautonome/eventAfternoonShower20260628">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">Afternoon shower event</rdfs:label>
        <rdfs:label xml:lang="fr">Événement de douche de l'après-midi</rdfs:label>
        <rdfs:comment xml:lang="en">An afternoon water consumption event.</rdfs:comment>
        <time:hasBeginning>
          <time:Instant rdf:nodeID="neafc0a186dcc47bc9e960b290a8eb5ceb27">
            <time:inXSDDateTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-28T15:49:48+02:00</time:inXSDDateTime>
          </time:Instant>
        </time:hasBeginning>
        <time:hasEnd>
          <time:Instant rdf:nodeID="neafc0a186dcc47bc9e960b290a8eb5ceb28">
            <time:inXSDDateTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-28T16:03:38+02:00</time:inXSDDateTime>
          </time:Instant>
        </time:hasEnd>
      </eau:ConsumptionEvent>
    </eau:hasConsumptionEvent>
  </sosa:ObservationCollection>
  <owl:DatatypeProperty rdf:about="https://w3id.org/eautonome/hasOperationalStatus">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/System"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has operational status</rdfs:label>
    <rdfs:comment xml:lang="en">Current status of the system, can be active, inactive, or planned.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
  </owl:DatatypeProperty>
  <sosa:Observation rdf:about="https://w3id.org/eautonome/obsFlowMainInlet20260627T020617">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
    <rdfs:comment xml:lang="en">Measurement of flow rate at the main inlet.</rdfs:comment>
    <sosa:madeBySensor>
      <eau:VortexFlowmeter rdf:about="https://w3id.org/eautonome/flowmeterMainInlet">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">Main inlet flowmeter</rdfs:label>
        <rdfs:label xml:lang="fr">Débitmètre entrée principale</rdfs:label>
        <rdfs:comment xml:lang="en">ifm vortex flowmeter DN10.</rdfs:comment>
        <eau:hasOperationalStatus>active</eau:hasOperationalStatus>
        <eau:hasFlowEquation>Q = 2.0 * (I - 4)</eau:hasFlowEquation>
        <eau:hasAnalogInput>AN3</eau:hasAnalogInput>
        <eau:monitors rdf:resource="https://w3id.org/eautonome/mpMainInlet"/>
        <sosa:observes rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:isHostedBy rdf:resource="https://w3id.org/eautonome/adcCard2"/>
        <sosa:implements rdf:resource="https://w3id.org/eautonome/eautonomeObservingProcedure"/>
      </eau:VortexFlowmeter>
    </sosa:madeBySensor>
    <sosa:observedProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
    <sosa:hasFeatureOfInterest>
      <eau:MeasurementPoint rdf:about="https://w3id.org/eautonome/mpMainInlet">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">Main inlet measurement point</rdfs:label>
        <rdfs:label xml:lang="fr">Point de mesure entrée principale</rdfs:label>
        <rdfs:comment xml:lang="en">Measurement point on the main cold water entry.</rdfs:comment>
        <eau:measuresWaterKind rdf:resource="https://saref.etsi.org/saref4watr/DrinkingWater"/>
        <eau:locatedIn rdf:resource="https://w3id.org/eautonome/roomBasement"/>
        <eau:measuresOnAsset rdf:resource="https://w3id.org/eautonome/pipeColdWaterEntry"/>
        <eau:servesEndpoint rdf:resource="https://w3id.org/eautonome/roomBasement"/>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:hasProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowTemperature"/>
      </eau:MeasurementPoint>
    </sosa:hasFeatureOfInterest>
    <sosa:hasUltimateFeatureOfInterest rdf:resource="https://w3id.org/eautonome/domesticGreywater"/>
    <sosa:usedProcedure>
      <eau:EautonomeObservingProcedure rdf:about="https://w3id.org/eautonome/eautonomeObservingProcedure">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
        <rdfs:label xml:lang="en">Eautonome observing procedure</rdfs:label>
        <rdfs:label xml:lang="fr">Procédure d'observation Eautonome</rdfs:label>
        <rdfs:comment xml:lang="en">Data acquisition via ADC on the Raspberry Pi.</rdfs:comment>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterHeaterOutput"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterBathroomHot"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterBathroomCold"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterWashingMachine"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterBasementCold"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterToiletCold"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterKitchenCold"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterKitchenHot"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterToiletSink"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/flowmeterMainInlet"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/tempSensorMainInlet"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/jumoDigiLineBoiler"/>
        <sosa:implementedBy rdf:resource="https://w3id.org/eautonome/jumoDigiLineShower"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowRate"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/FlowTemperature"/>
        <sosa:forProperty rdf:resource="https://saref.etsi.org/saref4watr/Conductivity"/>
        <eau:hasTriggerThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.05</eau:hasTriggerThreshold>
        <eau:hasSamplingPeriod rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2</eau:hasSamplingPeriod>
        <eau:hasTransmissionInterval rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">360</eau:hasTransmissionInterval>
      </eau:EautonomeObservingProcedure>
    </sosa:usedProcedure>
    <sosa:resultTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-27T02:06:17+02:00</sosa:resultTime>
    <sosa:hasSimpleResult rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.71</sosa:hasSimpleResult>
    <sosa:hasResult>
      <qudt:QuantityValue rdf:nodeID="neafc0a186dcc47bc9e960b290a8eb5ceb29">
        <qudt:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.71</qudt:value>
        <qudt:hasUnit rdf:resource="http://qudt.org/vocab/unit/L-PER-MIN"/>
      </qudt:QuantityValue>
    </sosa:hasResult>
  </sosa:Observation>
  <owl:DatatypeProperty rdf:about="https://w3id.org/eautonome/hasConductivityEquation">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has conductivity equation</rdfs:label>
    <rdfs:comment xml:lang="en">Equation relating sensor current to measured conductivity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
  </owl:DatatypeProperty>
  <eau:PipeConfiguration rdf:about="https://w3id.org/eautonome/pipeConfigurationCurved">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
    <rdfs:label xml:lang="en">Curved pipe configuration</rdfs:label>
    <rdfs:label xml:lang="fr">Configuration tuyau coudé</rdfs:label>
    <rdfs:comment xml:lang="en">A pipe configuration that includes a bend or elbow.</rdfs:comment>
  </eau:PipeConfiguration>
  <owl:DatatypeProperty rdf:about="https://w3id.org/eautonome/hasCalibrationIntercept">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">has calibration intercept</rdfs:label>
    <rdfs:comment xml:lang="en">Intercept for converting sensor readings to flow values.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/eautonome/hasCalibrationSlope">
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">has calibration slope</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric slope used to convert sensor readings to flow values.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
  </owl:DatatypeProperty>
  <sosa:ObservationCollection rdf:about="https://w3id.org/eautonome/obsColEveningShower20260627">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/eautonome/"/>
    <rdfs:label xml:lang="en">Evening shower consumption</rdfs:label>
    <rdfs:label xml:lang="fr">Consommation douche du soir</rdfs:label>
    <rdfs:comment xml:lang="en">Flow observations during the evening shower period.</rdfs:comment>
