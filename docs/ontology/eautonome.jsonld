  {
    "@id": "https://w3id.org/eautonome/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology",
      "http://purl.org/vocommons/voaf#Vocabulary"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@language": "en",
        "@value": "Önal, E. The Eautonome Ontology (Version v1.0.1). https://doi.org/10.5281/zenodo.22229871"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-04-03"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "https://w3id.org/people/erdemonal/me"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The Eautonome Ontology provides an OWL representation of residential water end-use monitoring. It models domestic water uses, quality levels, and greywater reuse processes, specifically describing the monitoring and observations of the system to reduce water consumption."
      },
      {
        "@language": "fr",
        "@value": "L'ontologie Eautonome fournit une représentation OWL du suivi des usages résidentiels de l'eau. Elle modélise les usages domestiques de l'eau, les niveaux de qualité et les processus de réutilisation des eaux grises, en décrivant spécifiquement le suivi et les observations du système pour réduire la consommation d'eau."
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@id": "https://doi.org/10.5281/zenodo.22229871"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://doi.org/10.5281/zenodo.21894601"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-04-04"
      }
