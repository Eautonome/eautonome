        [ sh:class <https://saref.etsi.org/core/Profile> ;
            sh:description "Links a device to its profile. Its inverse is saref:isProfileOf. The device should be linked to a certain commodity using OP saref:consumes, saref:produces, or saref:stores, and optionally to some property or state using OP saref:targets or its sub-properties." ;
            sh:name "has profile" ;
