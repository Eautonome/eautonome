            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 23 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Sensor> .

<https://saref.etsi.org/core/UnitOfMeasure> a sh:NodeShape ;
    rdfs:comment "The unit of measure is a standard for measurement of a quantity, such as a Property." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <https://saref.etsi.org/core/UnitOfMeasure> .

<https://saref.etsi.org/saref4watr/WaterProperty> a sh:NodeShape ;
    rdfs:comment "Class to group those properties related to the water." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:broader ],
        [ sh:description "Links a property to the feature kind or feature of interest it is a property of." ;
            sh:name "is property of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isPropertyOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/saref4watr/WaterProperty> .

<https://saref.etsi.org/core/Task> a sh:NodeShape ;
    rdfs:comment "The goal for which a device is designed, from a user perspective." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/Task> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path skos:broader ],
        [ sh:description "A relationship identifying an entity (e.g., a device) that can accomplish a task." ;
            sh:name "is accomplished by" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/isAccomplishedBy> ],
        [ sh:class <https://saref.etsi.org/core/Task> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:narrower ] ;
    sh:targetClass <https://saref.etsi.org/core/Task> .

<https://saref.etsi.org/saref4watr/WaterMeter> a sh:NodeShape ;
    rdfs:comment "A water meter is an instrument intended to measure continuously, memorize, and display the volume of water passing through the meter." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "The hardware version of a device." ;
            sh:maxCount 1 ;
            sh:name "has hardware version" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/saref4watr/hasHardwareVersion> ],
        [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
            sh:description "Links a device to its kind, a device kind. Kinds of devices describe models of devices, with common properties and common states having the same value, targeting the same properties and states, common functions, and common services." ;
            sh:name "has device kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasDeviceKind> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/Profile> ;
            sh:description "Links a device to its profile. Its inverse is saref:isProfileOf. The device should be linked to a certain commodity using OP saref:consumes, saref:produces, or saref:stores, and optionally to some property or state using OP saref:targets or its sub-properties." ;
            sh:name "has profile" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasProfile> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
            sh:description "Links a feature of interest to one of its states of interest." ;
            sh:name "has state of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasStateOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "links a feature of interest to its kind, a feature kind" ;
            sh:name "has feature kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/hasFeatureKind> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
            sh:description "Links an entity (e.g., device) to the procedure execution it made." ;
            sh:name "made execution" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/madeExecution> ],
        [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
            sh:description "Links a device to one of its functions of interest." ;
            sh:name "has function of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasFunctionOfInterest> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "The fabrication number of a device." ;
            sh:maxCount 1 ;
            sh:name "has fabrication number" ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/saref4watr/hasFabricationNumber> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:minCount 1 ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 18 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Service> ;
            sh:description "Links a device to a service it exposes to a network." ;
            sh:name "offers" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path <https://saref.etsi.org/core/offers> ],
        [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
            sh:description "Links a feature of interest to one of its properties of interest." ;
            sh:name "has property of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <https://saref.etsi.org/core/hasPropertyOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:in ( <https://saref.etsi.org/saref4watr/BatteryLastChange> <https://saref.etsi.org/saref4watr/BatteryOperatingTime> <https://saref.etsi.org/saref4watr/BatteryRemainingTime> <https://saref.etsi.org/saref4watr/MeterOnTime> <https://saref.etsi.org/saref4watr/MeterOperatingTime> ) ;
            sh:name "has property" ;
            sh:order 23 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 24 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 25 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "The firmware version of a device." ;
            sh:maxCount 1 ;
            sh:name "has firmware version" ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path <https://saref.etsi.org/saref4watr/hasFirmwareVersion> ] ;
    sh:targetClass <https://saref.etsi.org/saref4watr/WaterMeter> .

<https://saref.etsi.org/core/Operation> a sh:NodeShape ;
    rdfs:comment "A saref:Operation is the means of a service to communicate in a procedure-type manner over the network (i.e. transmit data to/from other devices). It is the –machine interpretable– exposure of a –human understandable– command to a network." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:description "Links a command or operation to its outputs." ;
            sh:name "has output" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasOutput> ],
        [ sh:class <https://saref.etsi.org/core/Service> ;
            sh:description "Links an operation to the service it belongs to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "is operation of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isOperationOf> ],
        [ sh:description "Links a service to some function or function of interest it exposes to the network. Also links an operation to some command or command of interest it exposes to the network." ;
            sh:name "represents" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/represents> ] ;
    sh:targetClass <https://saref.etsi.org/core/Operation> .

<https://saref.etsi.org/core/Profile> a sh:NodeShape ;
    rdfs:comment "A saref:Profile describes the money earned (negative values) or paied (positive values) for the use (production or consumption) of a commodity by a device in a certain context." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a profile to the device it describes. The device should be linked to a certain commodity using OP saref:consumes, saref:produces, or saref:stores, and optionally to some property or state using OP saref:targets or its sub-properties." ;
            sh:name "is profile of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/isProfileOf> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a profile to a state that contributes to restricting its applicable context." ;
            sh:name "when state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/whenState> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a profile to a property value that contributes to restricting its applicable context." ;
            sh:name "when property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/whenPropertyValue> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a profile to the money earned (negative values) or paid (positive values) for the use (production or consumption) of the commodity by the device" ;
            sh:name "has price" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/profileHasPrice> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution or a profile to an instant." ;
            sh:name "has timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasTimestamp> ] ;
    sh:targetClass <https://saref.etsi.org/core/Profile> .

<https://saref.etsi.org/core/Service> a sh:NodeShape ;
    rdfs:comment "A saref:Service is a digital representation of a function in a network, making it discoverable, registerable and remotely controllable in the network." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/Operation> ;
            sh:description "Links a service to one of its operations." ;
            sh:name "has operation" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/hasOperation> ],
        [ sh:class <https://saref.etsi.org/core/Device> ;
            sh:description "Links a service to the device that exposes it to a network" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "is offered by" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/isOfferedBy> ],
        [ sh:description "Links a service to some function or function of interest it exposes to the network. Also links an operation to some command or command of interest it exposes to the network." ;
            sh:name "represents" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/represents> ] ;
    sh:targetClass <https://saref.etsi.org/core/Service> .

time:TemporalDuration a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass time:TemporalDuration .

<https://saref.etsi.org/core/StateValue> a sh:NodeShape ;
    rdfs:comment "Describes the value for a state. The state value is optionally linked the states or states of interest it is a value of (OP saref:isValueOfState)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a state value to the state or state of interest it is a value of." ;
            sh:name "is value of state" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/isValueOfState> ] ;
    sh:targetClass <https://saref.etsi.org/core/StateValue> .

<https://saref.etsi.org/core/PropertyValue> a sh:NodeShape ;
    rdfs:comment "Describes the value for a property. The property value is optionally linked to its value expressed as an RDF literal (DP saref:hasValue), optionally to the unit of measurement (OP saref:isMeasuredIn), and optionally to the properties or properties of interest it is a value of (OP saref:isValueOfProperty)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateValue> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "Value of a property value expressed as an RDF literal. Note that, even if decimal values are expected, values could use other datatypes." ;
            sh:maxCount 1 ;
            sh:name "has value" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasValue> ],
        [ sh:class <https://saref.etsi.org/core/UnitOfMeasure> ;
            sh:description "A relationship identifying the unit of measure used for a certain entity." ;
            sh:maxCount 1 ;
            sh:name "is measured in" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isMeasuredIn> ],
        [ sh:description "Links a property value to the property or property of interest it is a value of." ;
            sh:name "is value of property" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isValueOfProperty> ] ;
    sh:targetClass <https://saref.etsi.org/core/PropertyValue> .

<https://saref.etsi.org/core/PropertyOfInterest> a sh:NodeShape ;
    rdfs:comment "Identifiable qualities of features of interest that can be target of devices, such as observed or controlled. An instance of saref:PropertyOfInterest is specific to a feature of interest. It is inherent to and cannot exist without that feature of interest." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "Links a property of interest to the feature of interest it is a property of." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "is property of interest of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/isPropertyOfInterestOf> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "links a property of interest to its kind, a property." ;
            sh:name "has property kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasPropertyKind> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/PropertyOfInterest> .

<https://saref.etsi.org/core/StateOfInterest> a sh:NodeShape ;
    rdfs:comment "Identifiable conditions that features of interest are or may be in, and that can be target of devices, such as observed and controlled. An instance of saref:StateOfInterest is specific to a feature of interest. It is inherent to and cannot exist without that feature of interest." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "Links a state of interest to the feature of interest it is a state of." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "is state of interest of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/isStateOfInterestOf> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "links a state of interest to its kind, a state" ;
            sh:name "has state kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasStateKind> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/StateOfInterest> .

<https://saref.etsi.org/core/State> a sh:NodeShape ;
    rdfs:comment "Identifiable conditions that features of interest are or may be in, and that can be target of devices, such as observed and controlled. A state can apply to different features of interest." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/State> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path skos:broader ],
        [ sh:description "Links a state to the feature kind or feature of interest it is a state of." ;
            sh:name "is state of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isStateOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/State> .

<https://saref.etsi.org/core/FeatureOfInterest> a sh:NodeShape ;
    rdfs:comment "A feature of interest represents any real world entity from which a property or a state may be targeted, such as observed and controlled. An instance of saref:FeatureOfInterest represents one specific real world entity." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
            sh:description "Links a feature of interest to one of its states of interest." ;
            sh:name "has state of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasStateOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "links a feature of interest to its kind, a feature kind" ;
            sh:name "has feature kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasFeatureKind> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
            sh:description "Links an entity (e.g., device) to the procedure execution it made." ;
            sh:name "made execution" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/madeExecution> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
            sh:description "Links a feature of interest to one of its properties of interest." ;
            sh:name "has property of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/core/hasPropertyOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 17 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/FeatureOfInterest> .

<https://saref.etsi.org/core/Property> a sh:NodeShape ;
    rdfs:comment "Identifiable qualities of features of interest that can be target of devices, such as observed or controlled. A property can apply to different features of interest." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:broader ],
        [ sh:description "Links a property to the feature kind or feature of interest it is a property of." ;
            sh:name "is property of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isPropertyOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Property> .

<https://saref.etsi.org/core/FeatureKind> a sh:NodeShape ;
    rdfs:comment "Feature kinds allow to describe kinds of features of interest, with common properties having the same value, and common states being the same. An instance of saref:FeatureKind represents an archetype of real world entities, for example to populate product catalogs." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path skos:broader ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/FeatureKind> .

<https://saref.etsi.org/core/Commodity> a sh:NodeShape ;
    rdfs:comment "A marketable item which may be supplied without qualitative differentiation." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path skos:broader ],
        [ sh:description "Links a commodity to the feature kind, feature of interest, or device, that produces it" ;
            sh:name "is produced by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isProducedBy> ],
        [ sh:description "Links a commodity to the feature kind, feature of interest, or device, that consumes it" ;
            sh:name "is consumed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isConsumedBy> ],
        [ sh:description "Links a commodity to the feature kind, feature of interest, or device, that stores it" ;
            sh:name "is stored by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/isStoredBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Commodity> .

<https://saref.etsi.org/core/Device> a sh:NodeShape ;
    rdfs:comment "A tangible object designed to accomplish a particular task. In order to accomplish this task, the device performs one or more functions. An instance of saref:Device represents one specific real world entity." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
            sh:description "Links a device to its kind, a device kind. Kinds of devices describe models of devices, with common properties and common states having the same value, targeting the same properties and states, common functions, and common services." ;
            sh:name "has device kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasDeviceKind> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/Profile> ;
            sh:description "Links a device to its profile. Its inverse is saref:isProfileOf. The device should be linked to a certain commodity using OP saref:consumes, saref:produces, or saref:stores, and optionally to some property or state using OP saref:targets or its sub-properties." ;
            sh:name "has profile" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasProfile> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
            sh:description "Links a feature of interest to one of its states of interest." ;
            sh:name "has state of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasStateOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "links a feature of interest to its kind, a feature kind" ;
            sh:name "has feature kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasFeatureKind> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
            sh:description "Links an entity (e.g., device) to the procedure execution it made." ;
            sh:name "made execution" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/madeExecution> ],
        [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
            sh:description "Links a device to one of its functions of interest." ;
            sh:name "has function of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/hasFunctionOfInterest> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Service> ;
            sh:description "Links a device to a service it exposes to a network." ;
            sh:name "offers" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <https://saref.etsi.org/core/offers> ],
        [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
            sh:description "Links a feature of interest to one of its properties of interest." ;
            sh:name "has property of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <https://saref.etsi.org/core/hasPropertyOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 20 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 22 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Device> .

<https://saref.etsi.org/core/CommandOfInterest> a sh:NodeShape ;
    rdfs:comment "The lowest-level directives a device supports and exposes to some network. Commands can target (OP saref:targets and its sub-properties) features, properties, or states. A saref:CommandOfInterest is a directives actually supported by a device and exposed to some network." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:description "Links a command or operation to its outputs." ;
            sh:name "has output" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasOutput> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it controls." ;
            sh:name "controls" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/controls> ],
        [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
            sh:description "Links a command of interest to the function of interest it is a command of." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "is command of interest of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/isCommandOfInterestOf> ],
        [ sh:class <https://saref.etsi.org/core/Command> ;
            sh:description "links a command of interest to its kind, a command." ;
            sh:name "has command kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasCommandKind> ] ;
    sh:targetClass <https://saref.etsi.org/core/CommandOfInterest> .

<https://saref.etsi.org/core/DeviceKind> a sh:NodeShape ;
    rdfs:comment "Device kinds allow to describe kinds of devices, with common properties and common states having the same value, targeting the same properties and states, common functions, and common services. Devices kinds may be used to describe models of devices in online catalogues." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path skos:broader ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:class <https://saref.etsi.org/core/Profile> ;
            sh:description "Links a device to its profile. Its inverse is saref:isProfileOf. The device should be linked to a certain commodity using OP saref:consumes, saref:produces, or saref:stores, and optionally to some property or state using OP saref:targets or its sub-properties." ;
            sh:name "has profile" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasProfile> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it controls." ;
            sh:name "controls" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/controls> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 16 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 17 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 19 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/DeviceKind> .

<https://saref.etsi.org/core/FunctionOfInterest> a sh:NodeShape ;
    rdfs:comment "Logical groups of commands that devices support to accomplish their tasks. Function can target (OP saref:targets and its sub-properties) features, properties, or states. An instance of saref:FunctionOfInterest is supported by exactly one device." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "links a function of interest to its kind, a function" ;
            sh:name "has function kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasFunctionKind> ],
        [ sh:class <https://saref.etsi.org/core/Device> ;
            sh:description "Links a function of interest to the device it is a function of." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "is function of interest of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isFunctionOfInterestOf> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:class <https://saref.etsi.org/core/Command> ;
            sh:description "Links a function or function of interest and the command it supports." ;
            sh:name "has command" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasCommand> ],
        [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
            sh:description "Links a function of interest to one of its commands of interest." ;
            sh:name "has command of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasCommandOfInterest> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it controls." ;
            sh:name "controls" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/controls> ] ;
    sh:targetClass <https://saref.etsi.org/core/FunctionOfInterest> .

<https://saref.etsi.org/core/Command> a sh:NodeShape ;
    rdfs:comment "The lowest-level directives a function exposes to some network. Commands can target (OP saref:targets and its sub-properties) features, properties, or states. An instance of saref:Command is independent of any device." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:description "Links a command and a function or function of interest that supports it." ;
            sh:name "is command of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/isCommandOf> ],
        [ sh:class <https://saref.etsi.org/core/Command> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/Command> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path skos:broader ],
        [ sh:description "Links a command or operation to its outputs." ;
            sh:name "has output" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasOutput> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it controls." ;
            sh:name "controls" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/controls> ] ;
    sh:targetClass <https://saref.etsi.org/core/Command> .

<https://saref.etsi.org/core/ProcedureExecution> a sh:NodeShape ;
    rdfs:comment "Represents the act of carrying out a procedure." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution to the instant of time when the activity was completed, expressed as an xsd:dateTime literal." ;
            sh:name "has result time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasResultTime> ],
        [ sh:description "Links a command execution to the command or command of interest that was executed. Also liks an operation execution to the operation that was executed" ;
            sh:name "is execution of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Operation> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isExecutionOf> ],
        [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution or a profile to an instant." ;
            sh:name "has timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasTimestamp> ],
        [ sh:description "Links a procedure execution (e.g., an observation) to its result (e.g., a property value)." ;
            sh:name "has result" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasResult> ],
        [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "Links a procedure execution to the entity (e.g., device) that made it." ;
            sh:name "made by" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/madeBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/ProcedureExecution> .

<https://saref.etsi.org/core/Function> a sh:NodeShape ;
    rdfs:comment "Logical groups of commands that devices support to accomplish their tasks. Function can target (OP saref:targets and its sub-properties) features, properties, or states. An instance of saref:Function can apply to different devices." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:broader ],
        [ sh:class <https://saref.etsi.org/core/Command> ;
            sh:description "Links a function and one of its mandatory commands" ;
            sh:name "has mandatory command" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasMandatoryCommand> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:class <https://saref.etsi.org/core/Command> ;
            sh:description "Links a function or function of interest and the command it supports." ;
            sh:name "has command" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasCommand> ],
        [ sh:description "Links a function to the feature kind or device it is a function of." ;
            sh:name "is function of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/isFunctionOf> ],
        [ sh:class <https://saref.etsi.org/core/Command> ;
            sh:description "Links a function and one of its optional commands" ;
            sh:name "has optional command" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasOptionalCommand> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it controls." ;
            sh:name "controls" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/controls> ] ;
    sh:targetClass <https://saref.etsi.org/core/Function> .

