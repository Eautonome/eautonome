@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

geo:Feature a sh:NodeShape ;
    rdfs:comment "This class represents the top-level feature type. This class is equivalent to GFI_Feature defined in ISO 19156:2011, and it is superclass of all feature types." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass geo:Feature .

geo:Geometry a sh:NodeShape ;
    rdfs:comment "The class represents the top-level geometry type. This class is equivalent to the UML class GM_Object defined in ISO 19107, and it is superclass of all geometry types." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass geo:Geometry .

geo:SpatialObject a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass geo:SpatialObject .

<http://www.opengis.net/ont/sf#Point> a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <http://www.opengis.net/ont/sf#Point> .

<http://www.opengis.net/ont/sf#Polygon> a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <http://www.opengis.net/ont/sf#Polygon> .

time:TemporalEntity a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass time:TemporalEntity .

time:TemporalPosition a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass time:TemporalPosition .

sosa:Deployment a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "deployed system" ;
            sh:order 0 ;
            sh:path sosa:deployedSystem ],
        [ sh:name "has feature of interest" ;
            sh:order 1 ;
            sh:path sosa:hasFeatureOfInterest ],
        [ sh:name "deployed on platform" ;
            sh:order 2 ;
            sh:path sosa:deployedOnPlatform ],
        [ sh:name "start time" ;
            sh:order 3 ;
            sh:path sosa:startTime ],
        [ sh:name "has ultimate feature of interest" ;
            sh:order 4 ;
            sh:path sosa:hasUltimateFeatureOfInterest ] ;
    sh:targetClass sosa:Deployment .

sosa:FeatureOfInterest a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "has property" ;
            sh:order 0 ;
            sh:path sosa:hasProperty ],
        [ sh:name "is feature of interest of" ;
            sh:order 1 ;
            sh:path sosa:isFeatureOfInterestOf ] ;
    sh:targetClass sosa:FeatureOfInterest .

sosa:Observation a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "observed property" ;
            sh:order 0 ;
            sh:path sosa:observedProperty ],
        [ sh:name "used procedure" ;
            sh:order 1 ;
            sh:path sosa:usedProcedure ],
        [ sh:name "made by sensor" ;
            sh:order 2 ;
            sh:path sosa:madeBySensor ],
        [ sh:name "has feature of interest" ;
            sh:order 3 ;
            sh:path sosa:hasFeatureOfInterest ],
        [ sh:name "phenomenon time" ;
            sh:order 4 ;
            sh:path sosa:phenomenonTime ],
        [ sh:name "result time" ;
            sh:order 5 ;
            sh:path sosa:resultTime ],
        [ sh:name "has simple result" ;
            sh:order 6 ;
            sh:path sosa:hasSimpleResult ],
        [ sh:name "has result" ;
            sh:order 7 ;
            sh:path sosa:hasResult ],
        [ sh:name "start time" ;
            sh:order 8 ;
            sh:path sosa:startTime ],
        [ sh:name "has ultimate feature of interest" ;
            sh:order 9 ;
            sh:path sosa:hasUltimateFeatureOfInterest ] ;
    sh:targetClass sosa:Observation .

sosa:ObservationCollection a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "observed property" ;
            sh:order 8 ;
            sh:path sosa:observedProperty ],
        [ sh:name "start time" ;
            sh:order 9 ;
            sh:path sosa:startTime ],
        [ sh:name "has ultimate feature of interest" ;
            sh:order 10 ;
            sh:path sosa:hasUltimateFeatureOfInterest ],
        [ sh:name "used procedure" ;
            sh:order 0 ;
            sh:path sosa:usedProcedure ],
        [ sh:name "made by sensor" ;
            sh:order 1 ;
            sh:path sosa:madeBySensor ],
        [ sh:name "has feature of interest" ;
            sh:order 2 ;
            sh:path sosa:hasFeatureOfInterest ],
        [ sh:name "phenomenon time" ;
            sh:order 3 ;
            sh:path sosa:phenomenonTime ],
        [ sh:name "result time" ;
            sh:order 4 ;
            sh:path sosa:resultTime ],
        [ sh:name "has simple result" ;
            sh:order 5 ;
            sh:path sosa:hasSimpleResult ],
        [ sh:name "has result" ;
            sh:order 6 ;
            sh:path sosa:hasResult ],
        [ sh:name "has member" ;
            sh:order 7 ;
            sh:path sosa:hasMember ] ;
    sh:targetClass sosa:ObservationCollection .

sosa:ObservingProcedure a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "for property" ;
            sh:order 0 ;
            sh:path sosa:forProperty ],
        [ sh:name "implemented by" ;
            sh:order 1 ;
            sh:path sosa:implementedBy ] ;
    sh:targetClass sosa:ObservingProcedure .

sosa:Platform a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "has deployment" ;
            sh:order 0 ;
            sh:path sosa:hasDeployment ],
        [ sh:name "hosts" ;
            sh:order 1 ;
            sh:path sosa:hosts ],
        [ sh:name "in deployment" ;
            sh:order 2 ;
            sh:path sosa:inDeployment ],
        [ sh:name "is hosted by" ;
            sh:order 3 ;
            sh:path sosa:isHostedBy ] ;
    sh:targetClass sosa:Platform .

sosa:Property a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "is observed by" ;
            sh:order 0 ;
            sh:path sosa:isObservedBy ] ;
    sh:targetClass sosa:Property .

sosa:Sensor a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "has deployment" ;
            sh:order 0 ;
            sh:path sosa:hasDeployment ],
        [ sh:name "has sub system" ;
            sh:order 1 ;
            sh:path sosa:hasSubSystem ],
        [ sh:name "implements" ;
            sh:order 2 ;
            sh:path sosa:implements ],
        [ sh:name "is hosted by" ;
            sh:order 3 ;
            sh:path sosa:isHostedBy ],
        [ sh:name "for property" ;
            sh:order 4 ;
            sh:path sosa:forProperty ],
        [ sh:name "has system capability" ;
            sh:order 5 ;
            sh:path sosa:hasSystemCapability ],
        [ sh:name "has operating conditions" ;
            sh:order 6 ;
            sh:path sosa:hasOperatingConditions ],
        [ sh:name "made observation" ;
            sh:order 7 ;
            sh:path sosa:madeObservation ],
        [ sh:name "observes" ;
            sh:order 8 ;
            sh:path sosa:observes ] ;
    sh:targetClass sosa:Sensor .

sosa:System a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "has deployment" ;
            sh:order 0 ;
            sh:path sosa:hasDeployment ],
        [ sh:name "has sub system" ;
            sh:order 1 ;
            sh:path sosa:hasSubSystem ],
        [ sh:name "implements" ;
            sh:order 2 ;
            sh:path sosa:implements ],
        [ sh:name "is hosted by" ;
            sh:order 3 ;
            sh:path sosa:isHostedBy ],
        [ sh:name "for property" ;
            sh:order 4 ;
            sh:path sosa:forProperty ],
        [ sh:name "has system capability" ;
            sh:order 5 ;
            sh:path sosa:hasSystemCapability ],
        [ sh:name "has operating conditions" ;
            sh:order 6 ;
            sh:path sosa:hasOperatingConditions ] ;
    sh:targetClass sosa:System .

<https://saref.etsi.org/core/Actuation> a sh:NodeShape ;
    rdfs:comment "A saref:Actuation is the act of carrying out a procedure to control the state of the world using an actuator. It links to an actuator to describe what made the actuation, and to the controlled feature, property, property of interest, state, or state of interest. Typically, its input is a property value or a state. An actuation of a state (OP saref:controls) should have a state as input (OP saref:hasInput). Respectively, an actuation of a property should have a property value as input." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution to the instant of time when the activity was completed, expressed as an xsd:dateTime literal." ;
            sh:name "has result time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasResultTime> ],
        [ sh:description "Links a command execution to the command or command of interest that was executed. Also liks an operation execution to the operation that was executed" ;
            sh:name "is execution of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Operation> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isExecutionOf> ],
        [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution or a profile to an instant." ;
            sh:name "has timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasTimestamp> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it controls." ;
            sh:minCount 1 ;
            sh:name "controls" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/controls> ],
        [ sh:description "Links a procedure execution (e.g., an observation) to its result (e.g., a property value)." ;
            sh:name "has result" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasResult> ],
        [ sh:class <https://saref.etsi.org/core/Actuator> ;
            sh:description "Links a procedure execution to the entity (e.g., device) that made it." ;
            sh:name "made by" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/madeBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Actuation> .

<https://saref.etsi.org/core/Appliance> a sh:NodeShape ;
    rdfs:comment "A device designed to accomplish a particular task for occupant use. It consumes, produces, or stores, some commodity." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
            sh:description "Links a device to its kind, a device kind. Kinds of devices describe models of devices, with common properties and common states having the same value, targeting the same properties and states, common functions, and common services." ;
            sh:name "has device kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasDeviceKind> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/Profile> ;
            sh:description "Links a device to its profile. Its inverse is saref:isProfileOf. The device should be linked to a certain commodity using OP saref:consumes, saref:produces, or saref:stores, and optionally to some property or state using OP saref:targets or its sub-properties." ;
            sh:name "has profile" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasProfile> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
            sh:description "Links a feature of interest to one of its states of interest." ;
            sh:name "has state of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasStateOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "links a feature of interest to its kind, a feature kind" ;
            sh:name "has feature kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasFeatureKind> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
            sh:description "Links an entity (e.g., device) to the procedure execution it made." ;
            sh:name "made execution" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/madeExecution> ],
        [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
            sh:description "Links a device to one of its functions of interest." ;
            sh:name "has function of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/hasFunctionOfInterest> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Service> ;
            sh:description "Links a device to a service it exposes to a network." ;
            sh:name "offers" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path <https://saref.etsi.org/core/offers> ],
        [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
            sh:description "Links a feature of interest to one of its properties of interest." ;
            sh:name "has property of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <https://saref.etsi.org/core/hasPropertyOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 20 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 22 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Appliance> .

<https://saref.etsi.org/core/CommandExecution> a sh:NodeShape ;
    rdfs:comment "Describes the execution of a command. Typically, its inputs and outputs are human understandable and relate to some feature of interest, such as its state (e.g., s4abcd:On), or the value of its temperature (e.g., property value 21.0 °C)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution to the instant of time when the activity was completed, expressed as an xsd:dateTime literal." ;
            sh:name "has result time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasResultTime> ],
        [ sh:description "Links a command execution to the command or command of interest that was executed. Also liks an operation execution to the operation that was executed" ;
            sh:name "is execution of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Operation> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isExecutionOf> ],
        [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution or a profile to an instant." ;
            sh:name "has timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasTimestamp> ],
        [ sh:description "Links a procedure execution (e.g., an observation) to its result (e.g., a property value)." ;
            sh:name "has result" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasResult> ],
        [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "Links a procedure execution to the entity (e.g., device) that made it." ;
            sh:name "made by" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/madeBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/CommandExecution> .

<https://saref.etsi.org/core/Meter> a sh:NodeShape ;
    rdfs:comment "A device designed to observe and additionally do some computation and/or display one or more properties of one or more features of interest." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
            sh:description "Links a device to its kind, a device kind. Kinds of devices describe models of devices, with common properties and common states having the same value, targeting the same properties and states, common functions, and common services." ;
            sh:name "has device kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasDeviceKind> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/Profile> ;
            sh:description "Links a device to its profile. Its inverse is saref:isProfileOf. The device should be linked to a certain commodity using OP saref:consumes, saref:produces, or saref:stores, and optionally to some property or state using OP saref:targets or its sub-properties." ;
            sh:name "has profile" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasProfile> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
            sh:description "Links a feature of interest to one of its states of interest." ;
            sh:name "has state of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasStateOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "links a feature of interest to its kind, a feature kind" ;
            sh:name "has feature kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasFeatureKind> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
            sh:description "Links an entity (e.g., device) to the procedure execution it made." ;
            sh:name "made execution" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/madeExecution> ],
        [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
            sh:description "Links a device to one of its functions of interest." ;
            sh:name "has function of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/hasFunctionOfInterest> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:minCount 1 ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 16 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Service> ;
            sh:description "Links a device to a service it exposes to a network." ;
            sh:name "offers" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path <https://saref.etsi.org/core/offers> ],
        [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
            sh:description "Links a feature of interest to one of its properties of interest." ;
            sh:name "has property of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <https://saref.etsi.org/core/hasPropertyOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 21 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 23 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Meter> .

<https://saref.etsi.org/core/Observation> a sh:NodeShape ;
    rdfs:comment "A saref:Observation is the act of carrying out a procedure to estimate or calculate a value of a property of a feature of interest, or a state of a feature of interest. It links to a sensor to describe what made the observation, and to the observed feature, property, property of interest, state, or state of interest. Typically, its result is a property value or a state. An observation of a state (OP saref:observes) should have a state as a result (OP saref:hasResult). Respectively, an observation of a property should have a property value as a result." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution to the instant of time when the activity was completed, expressed as an xsd:dateTime literal." ;
            sh:name "has result time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasResultTime> ],
        [ sh:description "Links a command execution to the command or command of interest that was executed. Also liks an operation execution to the operation that was executed" ;
            sh:name "is execution of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Operation> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isExecutionOf> ],
        [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it observes." ;
            sh:minCount 1 ;
            sh:name "observes" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/observes> ],
        [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution or a profile to an instant." ;
            sh:name "has timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasTimestamp> ],
        [ sh:description "Links a procedure execution (e.g., an observation) to its result (e.g., a property value)." ;
            sh:name "has result" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasResult> ],
        [ sh:class <https://saref.etsi.org/core/Sensor> ;
            sh:description "Links a procedure execution to the entity (e.g., device) that made it." ;
            sh:name "made by" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/madeBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/Observation> .

<https://saref.etsi.org/core/OperationExecution> a sh:NodeShape ;
    rdfs:comment "Describes the execution of an operation in a network: the–machine interpretable–  description of a communication between devices over the network. Typically, its input and result are network messages, that conform to the input and output of the executed operation." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a device, function, command, or procedure execution, to the feature, property, or state, it targets." ;
            sh:name "targets" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/targets> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution to the instant of time when the activity was completed, expressed as an xsd:dateTime literal." ;
            sh:name "has result time" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasResultTime> ],
        [ sh:description "Links a command execution to the command or command of interest that was executed. Also liks an operation execution to the operation that was executed" ;
            sh:name "is execution of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Operation> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/isExecutionOf> ],
        [ sh:description "Links a command, operation, or procedure execution, to its inputs." ;
            sh:name "has input" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasInput> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Links a procedure execution or a profile to an instant." ;
            sh:name "has timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasTimestamp> ],
        [ sh:description "Links a procedure execution (e.g., an observation) to its result (e.g., a property value)." ;
            sh:name "has result" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/hasResult> ],
        [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "Links a procedure execution to the entity (e.g., device) that made it." ;
            sh:name "made by" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/madeBy> ] ;
    sh:targetClass <https://saref.etsi.org/core/OperationExecution> .

<https://saref.etsi.org/saref4syst/System> a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass <https://saref.etsi.org/saref4syst/System> .

<https://saref.etsi.org/saref4watr/AcceptabilityProperty> a sh:NodeShape ;
    rdfs:comment "An acceptability property is a property of water that is related to its acceptability." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
