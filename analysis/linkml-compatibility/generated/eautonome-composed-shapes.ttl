        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ] ;
    sh:targetClass <https://saref.etsi.org/saref4watr/Channel> .

<https://saref.etsi.org/saref4watr/ChemicalProperty> a sh:NodeShape ;
    rdfs:comment "A chemical property is a property of water that is related to chemical components." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ],
        [ sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:broader ],
        [ sh:description "Links a property to the feature kind or feature of interest it is a property of." ;
            sh:name "is property of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isPropertyOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ] ;
    sh:targetClass <https://saref.etsi.org/saref4watr/ChemicalProperty> .

<https://saref.etsi.org/saref4watr/ConsumptionBasedTariff> a sh:NodeShape ;
    rdfs:comment "A consumption-based tariff is a tariff that is based on consumption." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class time:TemporalDuration ;
            sh:description "The period of a tariff." ;
            sh:name "has period" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/saref4watr/hasPeriod> ],
        [ sh:class time:TemporalDuration ;
            sh:description "The duration of a tariff." ;
            sh:name "has duration" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/saref4watr/hasDuration> ],
        [ sh:class time:TemporalDuration ;
            sh:description "The billing period of a tariff." ;
            sh:name "has billing period" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/saref4watr/hasBillingPeriod> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The start date and time of a tariff." ;
            sh:name "has start timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/saref4watr/hasStartTimestamp> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The billing date of a tariff." ;
            sh:name "has billing date" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/saref4watr/hasBillingDate> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "The financial consumption related to a tariff (e.g., prepaid tariffs)." ;
            sh:name "for financial consumption" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/saref4watr/forFinancialConsumption> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "The volume consumption related to a tariff (e.g., after consumption of 900 litres)." ;
            sh:name "for volume consumption" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/saref4watr/forVolumeConsumption> ],
        [ sh:class <https://saref.etsi.org/saref4watr/WaterMeter> ;
            sh:description "The water meter to which a tariff applies to." ;
            sh:name "applies to" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/saref4watr/appliesTo> ] ;
    sh:targetClass <https://saref.etsi.org/saref4watr/ConsumptionBasedTariff> .

<https://saref.etsi.org/saref4watr/DistributionSystem> a sh:NodeShape ;
    rdfs:comment "A water distribution system is an infrastructure to carry potable water from a centralized treatment plant or wells to water consumers in order to adequately deliver water to satisfy residential, commercial, industrial and fire fighting requirements." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
            sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has model" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://saref.etsi.org/core/hasModel> ],
        [ sh:class <https://saref.etsi.org/core/StateValue> ;
            sh:description "Links a feature kind, a feature of interest, or a state of interest, to a state value." ;
            sh:name "has state value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/core/hasStateValue> ],
        [ sh:datatype rdfs:Literal ;
            sh:description "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag." ;
            sh:name "has manufacturer" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/hasManufacturer> ],
        [ sh:class <https://saref.etsi.org/core/Function> ;
            sh:description "Links a feature kind or a device to one of its functions." ;
            sh:name "has function" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/hasFunction> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it produces" ;
            sh:name "produces" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/core/produces> ],
        [ sh:class <https://saref.etsi.org/core/StateOfInterest> ;
            sh:description "Links a feature of interest to one of its states of interest." ;
            sh:name "has state of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://saref.etsi.org/core/hasStateOfInterest> ],
        [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
            sh:description "links a feature of interest to its kind, a feature kind" ;
            sh:name "has feature kind" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://saref.etsi.org/core/hasFeatureKind> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it consumes" ;
            sh:name "consumes" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://saref.etsi.org/core/consumes> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 9 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:class <https://saref.etsi.org/core/Commodity> ;
            sh:description "Links a feature kind, feature of interest, or device, to the commodity it stores" ;
            sh:name "stores" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path <https://saref.etsi.org/core/stores> ],
        [ sh:class <https://saref.etsi.org/core/State> ;
            sh:description "Links a feature kind or a feature of interest to one of its states." ;
            sh:name "has state" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://saref.etsi.org/core/hasState> ],
        [ sh:class <https://saref.etsi.org/core/PropertyOfInterest> ;
            sh:description "Links a feature of interest to one of its properties of interest." ;
            sh:name "has property of interest" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <https://saref.etsi.org/core/hasPropertyOfInterest> ],
        [ sh:description "The type of water for which an infrastructure is designed for." ;
            sh:in ( <https://saref.etsi.org/saref4watr/DrinkingWater> <https://saref.etsi.org/saref4watr/RawWater> <https://saref.etsi.org/saref4watr/Stormwater> <https://saref.etsi.org/saref4watr/Wastewater> ) ;
            sh:minCount 1 ;
            sh:name "is designed for" ;
            sh:order 13 ;
            sh:path <https://saref.etsi.org/saref4watr/isDesignedFor> ],
        [ sh:class <https://saref.etsi.org/core/PropertyValue> ;
            sh:description "Links a feature kind, a feature of interest, or a property of interest, to a property value." ;
            sh:name "has property value" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path <https://saref.etsi.org/core/hasPropertyValue> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 15 ;
            sh:path <https://saref.etsi.org/core/isControlledBy> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:description "Links a feature kind or a feature of interest to one of its properties." ;
            sh:name "has property" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path <https://saref.etsi.org/core/hasProperty> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that observes it." ;
            sh:name "is observed by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 17 ;
            sh:path <https://saref.etsi.org/core/isObservedBy> ],
        [ sh:description "The intended use of the infrastructure." ;
            sh:in ( <https://saref.etsi.org/saref4watr/Agriculture> <https://saref.etsi.org/saref4watr/Aquaculture> <https://saref.etsi.org/saref4watr/Domestic> <https://saref.etsi.org/saref4watr/Industry> <https://saref.etsi.org/saref4watr/Recreation> ) ;
            sh:minCount 1 ;
            sh:name "is intended for" ;
            sh:order 18 ;
            sh:path <https://saref.etsi.org/saref4watr/isIntendedFor> ],
        [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
            sh:description "Links an entity (e.g., device) to the procedure execution it made." ;
            sh:name "made execution" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path <https://saref.etsi.org/core/madeExecution> ] ;
    sh:targetClass <https://saref.etsi.org/saref4watr/DistributionSystem> .

<https://saref.etsi.org/saref4watr/EnvironmentalProperty> a sh:NodeShape ;
    rdfs:comment "Class to group those properties related to the environment." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)" ;
            sh:name "consists of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Property> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/State> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 0 ;
            sh:path <https://saref.etsi.org/core/consistsOf> ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path skos:narrower ],
        [ sh:class <https://saref.etsi.org/core/Property> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path skos:broader ],
        [ sh:description "Links a property to the feature kind or feature of interest it is a property of." ;
            sh:name "is property of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/FeatureKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FeatureOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/core/isPropertyOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that targets it." ;
            sh:name "is target of" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/core/isTargetOf> ],
        [ sh:description "Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it." ;
            sh:name "is controlled by" ;
            sh:or ( [ sh:class <https://saref.etsi.org/core/DeviceKind> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Device> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Function> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/FunctionOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/Command> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/CommandOfInterest> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] [ sh:class <https://saref.etsi.org/core/ProcedureExecution> ;
                        sh:nodeKind sh:BlankNodeOrIRI ] ) ;
            sh:order 5 ;
