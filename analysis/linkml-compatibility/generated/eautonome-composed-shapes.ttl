<https://saref.etsi.org/saref4watr/Tariff> a sh:NodeShape ;
    rdfs:comment "A tariff is a schedule of rates or charges of a business or a public utility. Tariffs can be based on time, thresholds or consumption; however, combined tariffs may also exist that mix more than one of these types." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class time:TemporalDuration ;
            sh:description "The period of a tariff." ;
            sh:name "has period" ;
