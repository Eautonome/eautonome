            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://saref.etsi.org/saref4watr/hasBillingPeriod> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The start date and time of a tariff." ;
            sh:name "has start timestamp" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://saref.etsi.org/saref4watr/hasStartTimestamp> ],
        [ sh:datatype xsd:dateTime ;
            sh:description "The billing date of a tariff." ;
            sh:name "has billing date" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path <https://saref.etsi.org/saref4watr/hasBillingDate> ],
        [ sh:class <https://saref.etsi.org/saref4watr/WaterMeter> ;
            sh:description "The water meter to which a tariff applies to." ;
            sh:name "applies to" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://saref.etsi.org/saref4watr/appliesTo> ] ;
    sh:targetClass <https://saref.etsi.org/saref4watr/Tariff> .

