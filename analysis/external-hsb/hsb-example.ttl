eau:hsbDeployment a sosa:Deployment ;
    rdfs:label "HSB Living Lab deployment" ;
    sosa:deployedSystem eau:hsbSensorS0012,
        eau:hsbSensorS0101,
        eau:hsbSensorS0104,
        eau:hsbSensorS0105,
        eau:hsbSensorS0161,
        eau:hsbSensorS0162,
        eau:hsbSensorS0164,
        eau:hsbSensorS0202,
        eau:hsbSensorS0205 .

eau:hsbObservation000000 a sosa:Observation ;
    sosa:hasFeatureOfInterest eau:hsbMeasurementPointS0101 ;
    sosa:hasResult [ a qudt:QuantityValue ;
            qudt:hasUnit unit:M3 ;
            qudt:value 0.01 ] ;
    sosa:hasSimpleResult 0.01 ;
    sosa:madeBySensor eau:hsbSensorS0101 ;
    sosa:observedProperty s4watr:FlowVolume ;
    sosa:resultTime "2019-12-31T00:00:00+00:00"^^xsd:dateTime ;
    sosa:usedProcedure eau:hsbObservingProcedure .

