eau:hsbRoomR008 a eau:DomesticRoom ;
    rdfs:label "R008 (Living room)" ;
    dcterms:isPartOf eau:hsbApartmentAPT_009 ;
    rdfs:comment "Room type in the source data: Living room." .

eau:hsbRoomR025 a eau:DomesticRoom ;
    rdfs:label "R025 (Bathroom)" ;
    dcterms:isPartOf eau:hsbApartmentAPT_005 ;
    rdfs:comment "Room type in the source data: Bathroom." .

eau:hsbMeasurementPointS0012 a eau:MeasurementPoint ;
    rdfs:label "HSB measurement point S0012" ;
    sosa:hasProperty s4watr:FlowVolume ;
    eau:locatedIn eau:hsbRoomR008 ;
    eau:measuresOnAsset eau:hsbAssetS0012 ;
    eau:measuresWaterKind eau:hsbHotWater .

